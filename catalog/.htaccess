Options -Indexes
RewriteEngine On

# Emergency 2026-11-09: source network observed making >800 heavy catalogue
# requests per 5 minutes from hundreds of rotating hosts. This rule has
# a deliberately narrow route scope and should be reviewed after the flood.
# Windows Apache executes this BEFORE the PHP package reader.
RewriteCond %{REMOTE_ADDR} ^47\.79\.20[0-7]\.[0-9]{1,3}$ [NC]
RewriteRule ^(file-examine|file-examine-export|feedback|package-coverage)\.php$ - [F,L]

# Resource-intensive File Examine pages always require a signed manual gate
# for EXTERNAL visitors, even when Referer claims to be Google or the site.
# Bots can forge Referer. Internal/LAN users retain unrestricted access.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{REMOTE_ADDR} !^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.) [NC]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)UEDB_GATE_PASS= [NC]
RewriteRule ^file-examine\.php$ /catalog/direct-entry.html?to=file-examine.php [R=302,L,QSA,NE]

# For the less expensive public routes, a known same-site/search referral
# remains exempt; unknown/empty referrals must pass static verification.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{REMOTE_ADDR} !^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.) [NC]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)UEDB_GATE_PASS= [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?(unrealdb\.com|192\.168\.0\.55|192\.168\.0\.51)(:[0-9]+)?(/|$) [NC]
RewriteCond %{HTTP_REFERER} !^https?://((www\.)?google\.(com|ie|co\.uk|de|fr|es|it|ca|com\.au|co\.jp|nl|be|ch|pl|pt|com\.br|co\.in)|((www\.)?bing\.com)|((www\.)?duckduckgo\.com)|(search\.yahoo\.com)|((www\.|search\.)?brave\.com)|((www\.)?ecosia\.org))(/|$) [NC]
RewriteRule ^(game-files|access-matrix)\.php$ /catalog/direct-entry.html?to=$1.php [R=302,L,QSA,NE]


# Catalog pages contain session-specific admin controls and CSRF tokens. Never
# allow browsers or intermediary caches to reuse rendered PHP responses.
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# Preserve the legacy public game-page redirect.
RewriteCond %{QUERY_STRING} (^|&)page=game(&|$)
RewriteRule ^index\.php$ game-page.php [L,QSA]

# Runtime code, configuration and catalog content must not be directly served.
RewriteRule ^(?:bin|lib|src|storage)(?:/|$) - [F,L]
RewriteRule ^(?:config\.php|config\.example\.php)$ - [F,L]

<FilesMatch "\.(?:log|sql|bak|tmp|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
