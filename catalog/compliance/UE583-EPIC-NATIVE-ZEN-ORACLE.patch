diff --git a/Engine/Source/Programs/UnrealPackageTool/UnrealPackageTool.cpp b/Engine/Source/Programs/UnrealPackageTool/UnrealPackageTool.cpp
index a7bf74d..90899c7 100644
--- a/Engine/Source/Programs/UnrealPackageTool/UnrealPackageTool.cpp
+++ b/Engine/Source/Programs/UnrealPackageTool/UnrealPackageTool.cpp
@@ -13,6 +13,9 @@
 #include "HAL/FileManager.h"
 #include "HAL/PlatformFile.h"
 #include "Misc/CommandLine.h"
+#include "Misc/FileHelper.h"
+#include "Serialization/ZenPackageHeader.h"
+#include "IO/IoStore.h"
 #include "Misc/ObjectThumbnail.h"
 #include "Misc/PackagePath.h"
 #include "Misc/Parse.h"
@@ -1244,6 +1247,104 @@ INT32_MAIN_INT32_ARGC_TCHAR_ARGV()
 {
 	using namespace UE::PackageTool;
 	int32 Ret = GEngineLoop.PreInit(ArgC, ArgV);
+	FString TocProbePath;
+	if (FParse::Value(FCommandLine::Get(), TEXT("TocProbe="), TocProbePath))
+	{
+		FIoStoreTocResourceView View;
+		FIoStoreTocResourceStorage Storage;
+		const FIoStatus Status = FIoStoreTocResourceView::Read(*TocProbePath, EIoStoreTocReadOptions::ReadAll, View, Storage);
+		if (!Status.IsOk())
+		{
+			printf("UE583_NATIVE_TOC_ERROR source_read_failed\\n");
+			return 3;
+		}
+		const FIoStoreTocHeader& H = View.Header;
+		printf("UE583_NATIVE_TOC_ORACLE %u %u %u %u %u %u %u %u %u %u %u %u %d %d %d %d %d %d %d\\n",
+			static_cast<uint32>(H.Version), H.TocHeaderSize, H.TocEntryCount, H.TocCompressedBlockEntryCount,
+			H.TocCompressedBlockEntrySize, H.CompressionMethodNameCount, H.CompressionMethodNameLength,
+			H.CompressionBlockSize, H.DirectoryIndexSize, H.PartitionCount,
+			H.TocChunkPerfectHashSeedsCount, H.TocChunksWithoutPerfectHashCount,
+			View.ChunkIds.Num(), View.ChunkOffsetLengths.Num(), View.CompressionBlocks.Num(),
+			View.CompressionMethods.Num(), View.DirectoryIndexBuffer.Num(), View.ChunkMetas.Num(),
+			View.LegacyChunkMetas.Num());
+		for (int32 I = 0; I < View.ChunkOffsetLengths.Num(); ++I)
+		{
+			printf("UE583_NATIVE_TOC_CHUNK %d %llu %llu %u\\n", I,
+				static_cast<unsigned long long>(View.ChunkOffsetLengths[I].GetOffset()),
+				static_cast<unsigned long long>(View.ChunkOffsetLengths[I].GetLength()),
+				static_cast<uint32>(View.ChunkIds[I].GetChunkType()));
+		}
+		for (int32 I = 0; I < View.CompressionBlocks.Num(); ++I)
+		{
+			const FIoStoreTocCompressedBlockEntry& B = View.CompressionBlocks[I];
+			printf("UE583_NATIVE_TOC_BLOCK %d %llu %u %u %u\\n", I,
+				static_cast<unsigned long long>(B.GetOffset()), B.GetCompressedSize(), B.GetUncompressedSize(),
+				static_cast<uint32>(B.GetCompressionMethodIndex()));
+		}
+		return 0;
+	}
+	FString ZenHeaderProbePath;
+	if (FParse::Value(FCommandLine::Get(), TEXT("ZenHeaderProbe="), ZenHeaderProbePath))
+	{
+		TArray<uint8> ZenBytes;
+		if (!FFileHelper::LoadFileToArray(ZenBytes, *ZenHeaderProbePath))
+		{
+			printf("UE583_NATIVE_ZEN_ORACLE_ERROR cannot_read_file\\n");
+			return 2;
+		}
+		FString ZenError;
+		const FZenPackageHeader Header = FZenPackageHeader::MakeView(
+			FMemoryView(ZenBytes.GetData(), static_cast<uint64>(ZenBytes.Num())), ZenError);
+		if (!ZenError.IsEmpty() || Header.PackageSummary == nullptr)
+		{
+			printf("UE583_NATIVE_ZEN_ORACLE_ERROR invalid_header\\n");
+			return 3;
+		}
+		const FZenPackageSummary& S = *Header.PackageSummary;
+		const int32 UE4 = Header.VersioningInfo.IsSet() ? Header.VersioningInfo->PackageVersion.FileVersionUE4 : -1;
+		const int32 UE5 = Header.VersioningInfo.IsSet() ? Header.VersioningInfo->PackageVersion.FileVersionUE5 : -1;
+        printf(R"(UE583_NATIVE_ZEN_ORACLE {"has_versioning_info":%u,"header_size":%u,"package_flags":%u,"imported_public_export_hashes_offset":%d,"import_map_offset":%d,"export_map_offset":%d,"export_bundle_entries_offset":%d,"dependency_bundle_headers_offset":%d,"dependency_bundle_entries_offset":%d,"imported_package_names_offset":%d,"ue4_version":%d,"ue5_version":%d,"imported_hash_count":%d,"import_count":%d,"export_count":%d,"cell_import_count":%d,"cell_export_count":%d,"bulk_data_count":%d,"export_bundle_count":%d,"dependency_bundle_header_count":%d,"dependency_bundle_entry_count":%d})" "\n",
+			S.bHasVersioningInfo, S.HeaderSize, S.PackageFlags,
+			S.ImportedPublicExportHashesOffset, S.ImportMapOffset, S.ExportMapOffset,
+			S.ExportBundleEntriesOffset, S.DependencyBundleHeadersOffset, S.DependencyBundleEntriesOffset,
+			S.ImportedPackageNamesOffset, UE4, UE5,
+			Header.ImportedPublicExportHashes.Num(), Header.ImportMap.Num(), Header.ExportMap.Num(),
+			Header.CellImportMap.Num(), Header.CellExportMap.Num(), Header.BulkDataMap.Num(),
+			Header.ExportBundleEntries.Num(), Header.DependencyBundleHeaders.Num(), Header.DependencyBundleEntries.Num());
+		for (int32 Index = 0; Index < Header.ExportMap.Num(); ++Index)
+		{
+			const FExportMapEntry& Row = Header.ExportMap[Index];
+			printf("UE583_NATIVE_ZEN_EXPORT %d %llu %llu %llu %u %u\\n", Index,
+				static_cast<unsigned long long>(Row.CookedSerialOffset),
+				static_cast<unsigned long long>(Row.CookedSerialSize),
+				static_cast<unsigned long long>(Row.PublicExportHash),
+				static_cast<uint32>(Row.ObjectFlags), static_cast<uint32>(Row.FilterFlags));
+		}
+		for (int32 Index = 0; Index < Header.DependencyBundleHeaders.Num(); ++Index)
+		{
+			const FDependencyBundleHeader& Row = Header.DependencyBundleHeaders[Index];
+			printf("UE583_NATIVE_ZEN_DEPHEADER %d %d %u %u %u %u\\n", Index, Row.FirstEntryIndex,
+				Row.EntryCount[0][0], Row.EntryCount[0][1], Row.EntryCount[1][0], Row.EntryCount[1][1]);
+		}
+		for (int32 Index = 0; Index < Header.ImportMap.Num(); ++Index)
+		{
+			const FPackageObjectIndex& Row = Header.ImportMap[Index];
+			const uint64 Raw = Row.IsNull() ? ~uint64(0) :
+				((uint64(Row.IsPackageImport() ? 2 : Row.IsScriptImport() ? 1 : 0) << 62) | Row.Value());
+			printf("UE583_NATIVE_ZEN_IMPORT %d %016llX\\n", Index, static_cast<unsigned long long>(Raw));
+		}
+		for (int32 Index = 0; Index < Header.ExportMap.Num(); ++Index)
+		{
+			printf("UE583_NATIVE_ZEN_PUBHASH %d %016llX\\n", Index,
+				static_cast<unsigned long long>(Header.ExportMap[Index].PublicExportHash));
+		}
+		for (int32 Index = 0; Index < Header.DependencyBundleEntries.Num(); ++Index)
+		{
+			printf("UE583_NATIVE_ZEN_DEPENTRY %d %d\\n", Index,
+				Header.DependencyBundleEntries[Index].LocalImportOrExportIndex.ForDebugging());
+		}
+		return 0;
+	}
 
 	// Disable all logging because we want to output to stdout
 	FSelfRegisteringExec::StaticExec(nullptr, TEXT("log logunrealpackagetool only"), *GLog);
