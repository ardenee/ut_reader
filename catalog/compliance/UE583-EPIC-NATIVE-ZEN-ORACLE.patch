@@ -1244,6 +1249,293 @@ INT32_MAIN_INT32_ARGC_TCHAR_ARGV()
 {
 	using namespace UE::PackageTool;
 	int32 Ret = GEngineLoop.PreInit(ArgC, ArgV);
+	FString FileStorePriorityProbePath;
+	if (FParse::Value(FCommandLine::Get(), TEXT("FileStorePriorityProbe="), FileStorePriorityProbePath))
+	{
+		TArray<uint8> Raw;
+		if (!FFileHelper::LoadFileToArray(Raw, *FileStorePriorityProbePath))
+		{
+			printf("UE583_NATIVE_PRIORITY_ERROR cannot_read\\n");
+			return 2;
+		}
+		FMemoryReader ReaderA(Raw, true);
+		FMemoryReader ReaderB(Raw, true);
+		FIoContainerHeader HeaderA, HeaderB;
+		ReaderA << HeaderA;
+		ReaderB << HeaderB;
+		if (ReaderA.IsError() || ReaderB.IsError() || HeaderB.StoreEntries.Num() < 24 || HeaderA.PackageIds.IsEmpty())
+		{
+			printf("UE583_NATIVE_PRIORITY_ERROR invalid_fixture\\n");
+			return 3;
+		}
+		const FPackageId Id = HeaderA.PackageIds[0];
+		FPackageId HighProvider = FPackageId::FromValue(0x1111222233334444ull);
+		FMemory::Memcpy(HeaderB.StoreEntries.GetData() + 16, &HighProvider, sizeof(FPackageId));
+		FFilePackageStoreBackend Backend;
+		Backend.Mount(&HeaderA, 10);
+		Backend.Mount(&HeaderB, 20);
+		Backend.BeginRead();
+		FPackageStoreEntry High;
+		const auto HighStatus = Backend.GetPackageStoreEntry(Id, NAME_None, High);
+		const uint64 HighId = High.ImportedPackageIds.Num() ? High.ImportedPackageIds[0].Value() : 0;
+		Backend.EndRead();
+		Backend.Unmount(&HeaderB);
+		Backend.BeginRead();
+		FPackageStoreEntry Restored;
+		const auto RestoreStatus = Backend.GetPackageStoreEntry(Id, NAME_None, Restored);
+		const uint64 RestoreId = Restored.ImportedPackageIds.Num() ? Restored.ImportedPackageIds[0].Value() : 0;
+		Backend.EndRead();
+		Backend.Unmount(&HeaderA);
+		Backend.BeginRead();
+		FPackageStoreEntry Removed;
+		const auto RemovedStatus = Backend.GetPackageStoreEntry(Id, NAME_None, Removed);
+		Backend.EndRead();
+		printf("UE583_NATIVE_FILESTORE_PRIORITY %d %016llX %d %016llX %d\\n",
+			static_cast<int32>(HighStatus), static_cast<unsigned long long>(HighId),
+			static_cast<int32>(RestoreStatus), static_cast<unsigned long long>(RestoreId),
+			static_cast<int32>(RemovedStatus));
+		return 0;
+	}
+	FString FileStoreProbePath;
+	if (FParse::Value(FCommandLine::Get(), TEXT("FileStoreProbe="), FileStoreProbePath))
+	{
+		TArray<uint8> Raw;
+		if (!FFileHelper::LoadFileToArray(Raw, *FileStoreProbePath))
+		{
+			printf("UE583_NATIVE_FILESTORE_ERROR cannot_read\\n");
+			return 2;
+		}
+		FMemoryReader Archive(Raw, true);
+		FIoContainerHeader Header;
+		Archive << Header;
+		if (Archive.IsError() || Header.PackageIds.IsEmpty())
+		{
+			printf("UE583_NATIVE_FILESTORE_ERROR invalid_header\\n");
+			return 3;
+		}
+		const FPackageId Id = Header.PackageIds[0];
+		const FPackageId MissingId = FPackageId::FromValue(0x9999111122223333ull);
+		FFilePackageStoreBackend Backend;
+		Backend.Mount(&Header, 10);
+		Backend.BeginRead();
+		FPackageStoreEntry Entry;
+		const EPackageStoreEntryStatus Status = Backend.GetPackageStoreEntry(Id, NAME_None, Entry);
+		FPackageStoreEntry MissingEntry;
+		const EPackageStoreEntryStatus MissingStatus = Backend.GetPackageStoreEntry(MissingId, NAME_None, MissingEntry);
+		FName RedirectName;
+		FPackageId RedirectTarget;
+		const bool HasRedirect = Backend.GetPackageRedirectInfo(FPackageId::FromValue(0xAAAA000000001111ull), RedirectName, RedirectTarget);
+		printf("UE583_NATIVE_FILESTORE_MOUNT %d %d %d %d %016llX\\n",
+			static_cast<int32>(Status), Entry.ImportedPackageIds.Num(), static_cast<int32>(MissingStatus),
+			static_cast<int32>(HasRedirect),
+			static_cast<unsigned long long>(HasRedirect ? RedirectTarget.Value() : 0));
+#if WITH_EDITOR
+		printf("UE583_NATIVE_FILESTORE_OPTIONAL %u %d\\n",
+			static_cast<uint32>(Entry.bHasOptionalSegment), Entry.OptionalSegmentImportedPackageIds.Num());
+#else
+		printf("UE583_NATIVE_FILESTORE_OPTIONAL_UNAVAILABLE editor_disabled\\n");
+#endif
+		Backend.EndRead();
+		Backend.Unmount(&Header);
+		Backend.BeginRead();
+		FPackageStoreEntry AfterUnmount;
+		const EPackageStoreEntryStatus UnmountedStatus = Backend.GetPackageStoreEntry(Id, NAME_None, AfterUnmount);
+		Backend.EndRead();
+		printf("UE583_NATIVE_FILESTORE_UNMOUNT %d\\n", static_cast<int32>(UnmountedStatus));
+		return 0;
+	}
+	FString ContainerHeaderProbePath;
+	if (FParse::Value(FCommandLine::Get(), TEXT("ContainerHeaderProbe="), ContainerHeaderProbePath))
+	{
+		TArray<uint8> Raw;
+		if (!FFileHelper::LoadFileToArray(Raw, *ContainerHeaderProbePath))
+		{
+			printf("UE583_NATIVE_CONTAINER_ERROR cannot_read\\n");
+			return 2;
+		}
+		FMemoryReader Archive(Raw, true);
+		FIoContainerHeader Header;
+		Archive << Header;
+		if (Archive.IsError())
+		{
+			printf("UE583_NATIVE_CONTAINER_ERROR deserialize\\n");
+			return 3;
+		}
+		printf("UE583_NATIVE_CONTAINER_COUNTS %d %d %d %d %d %d\\n",
+			Header.PackageIds.Num(), Header.OptionalSegmentPackageIds.Num(),
+			Header.StoreEntries.Num(), Header.OptionalSegmentStoreEntries.Num(),
+			Header.LocalizedPackages.Num(), Header.PackageRedirects.Num());
+		for (int32 I = 0; I < Header.PackageIds.Num(); ++I)
+		{
+			const auto* Entry = reinterpret_cast<const FFilePackageStoreEntry*>(Header.StoreEntries.GetData());
+			printf("UE583_NATIVE_CONTAINER_MAIN %d %016llX %d\\n", I,
+				static_cast<unsigned long long>(Header.PackageIds[I].Value()), Entry[I].ImportedPackages.Num());
+			for (uint32 J = 0; J < Entry[I].ImportedPackages.Num(); ++J)
+			{
+				printf("UE583_NATIVE_CONTAINER_MAIN_IMPORT %d %u %016llX\\n", I, J, static_cast<unsigned long long>(Entry[I].ImportedPackages[J].Value()));
+			}
+		}
+		for (int32 I = 0; I < Header.OptionalSegmentPackageIds.Num(); ++I)
+		{
+			const auto* Entry = reinterpret_cast<const FFilePackageStoreEntry*>(Header.OptionalSegmentStoreEntries.GetData());
+			printf("UE583_NATIVE_CONTAINER_OPTIONAL %d %016llX %d\\n", I,
+				static_cast<unsigned long long>(Header.OptionalSegmentPackageIds[I].Value()), Entry[I].ImportedPackages.Num());
+			for (uint32 J = 0; J < Entry[I].ImportedPackages.Num(); ++J)
+			{
+				printf("UE583_NATIVE_CONTAINER_OPTIONAL_IMPORT %d %u %016llX\\n", I, J, static_cast<unsigned long long>(Entry[I].ImportedPackages[J].Value()));
+			}
+		}
+		return 0;
+	}
+	FString DependsProbePath;
+	if (FParse::Value(FCommandLine::Get(), TEXT("DependsProbe="), DependsProbePath))
+	{
+		FPackageReader Reader;
+		TArray<TArray<FPackageIndex>> Depends;
+		if (!Reader.OpenPackageFile(DependsProbePath) || !Reader.GetDependsMap(Depends))
+		{
+			printf("UE583_NATIVE_DEPENDS_ERROR cannot_read\\n");
+			return 3;
+		}
+		printf("UE583_NATIVE_DEPENDS_COUNT %d\\n", Depends.Num());
+		for (int32 ExportIndex = 0; ExportIndex < Depends.Num(); ++ExportIndex)
+		{
+			printf("UE583_NATIVE_DEPENDS_ROW %d %d", ExportIndex, Depends[ExportIndex].Num());
+			for (const FPackageIndex& Reference : Depends[ExportIndex])
+			{
+				printf(" %d", Reference.ForDebugging());
+			}
+			printf("\\n");
+		}
+		return 0;
+	}
+	FString TocProbePath;
+	if (FParse::Value(FCommandLine::Get(), TEXT("TocProbe="), TocProbePath))
+	{
+		FIoStoreTocResourceView View;
+		FIoStoreTocResourceStorage Storage;
+		const FIoStatus Status = FIoStoreTocResourceView::Read(*TocProbePath, EIoStoreTocReadOptions::ReadAll, View, Storage);
+		if (!Status.IsOk())
+		{
+			printf("UE583_NATIVE_TOC_ERROR source_read_failed\\n");
+			return 3;
+		}
+		const FIoStoreTocHeader& H = View.Header;
+		auto ToUpperHex = [](const uint8* Data, int32 Length) -> std::string
+		{
+			static constexpr char HexDigits[] = "0123456789ABCDEF";
+			std::string Hex(static_cast<size_t>(Length) * 2, '0');
+			for (int32 I = 0; I < Length; ++I)
+			{
+				Hex[static_cast<size_t>(I) * 2] = HexDigits[Data[I] >> 4];
+				Hex[static_cast<size_t>(I) * 2 + 1] = HexDigits[Data[I] & 15];
+			}
+			return Hex;
+		};
+		printf("UE583_NATIVE_TOC_ORACLE %u %u %u %u %u %u %u %u %u %u %u %u %d %d %d %d %d %d %d\\n",
+			static_cast<uint32>(H.Version), H.TocHeaderSize, H.TocEntryCount, H.TocCompressedBlockEntryCount,
+			H.TocCompressedBlockEntrySize, H.CompressionMethodNameCount, H.CompressionMethodNameLength,
+			H.CompressionBlockSize, H.DirectoryIndexSize, H.PartitionCount,
+			H.TocChunkPerfectHashSeedsCount, H.TocChunksWithoutPerfectHashCount,
+			View.ChunkIds.Num(), View.ChunkOffsetLengths.Num(), View.CompressionBlocks.Num(),
+			View.CompressionMethods.Num(), View.DirectoryIndexBuffer.Num(), View.ChunkMetas.Num(),
+			View.LegacyChunkMetas.Num());
+		for (int32 I = 0; I < View.ChunkOffsetLengths.Num(); ++I)
+		{
+			printf("UE583_NATIVE_TOC_CHUNK %d %llu %llu %u\\n", I,
+				static_cast<unsigned long long>(View.ChunkOffsetLengths[I].GetOffset()),
+				static_cast<unsigned long long>(View.ChunkOffsetLengths[I].GetLength()),
+				static_cast<uint32>(View.ChunkIds[I].GetChunkType()));
+		}
+		for (int32 I = 0; I < View.CompressionBlocks.Num(); ++I)
+		{
+			const FIoStoreTocCompressedBlockEntry& B = View.CompressionBlocks[I];
+			printf("UE583_NATIVE_TOC_BLOCK %d %llu %u %u %u\\n", I,
+				static_cast<unsigned long long>(B.GetOffset()), B.GetCompressedSize(), B.GetUncompressedSize(),
+				static_cast<uint32>(B.GetCompressionMethodIndex()));
+		}
+		for (int32 I = 0; I < View.ChunkIds.Num(); ++I)
+		{
+			printf("UE583_NATIVE_TOC_IDMETA %d %s %s %u\\n", I,
+				ToUpperHex(View.ChunkIds[I].GetData(), 12).c_str(),
+				ToUpperHex(View.ChunkMetas[I].ChunkHash.GetBytes(), 20).c_str(),
+				static_cast<uint32>(View.ChunkMetas[I].Flags));
+		}
+		for (int32 I = 0; I < View.ChunkPerfectHashSeeds.Num(); ++I)
+		{
+			printf("UE583_NATIVE_TOC_SEED %d %d\\n", I, View.ChunkPerfectHashSeeds[I]);
+		}
+		for (int32 I = 0; I < View.ChunkIndicesWithoutPerfectHash.Num(); ++I)
+		{
+			printf("UE583_NATIVE_TOC_OVERFLOW %d %d\\n", I, View.ChunkIndicesWithoutPerfectHash[I]);
+		}
+		FSHAHash DirectorySha1;
+		FSHA1::HashBuffer(View.DirectoryIndexBuffer.GetData(), View.DirectoryIndexBuffer.Num(), DirectorySha1.Hash);
+		printf("UE583_NATIVE_TOC_DIRECTORY_SHA1 %s\\n", ToUpperHex(DirectorySha1.Hash, 20).c_str());
+		return 0;
+	}
+	FString ZenHeaderProbePath;
+	if (FParse::Value(FCommandLine::Get(), TEXT("ZenHeaderProbe="), ZenHeaderProbePath))
+	{
+		TArray<uint8> ZenBytes;
+		if (!FFileHelper::LoadFileToArray(ZenBytes, *ZenHeaderProbePath))
+		{
+			printf("UE583_NATIVE_ZEN_ORACLE_ERROR cannot_read_file\\n");
+			return 2;
+		}
+		FString ZenError;
+		const FZenPackageHeader Header = FZenPackageHeader::MakeView(
+			FMemoryView(ZenBytes.GetData(), static_cast<uint64>(ZenBytes.Num())), ZenError);
+		if (!ZenError.IsEmpty() || Header.PackageSummary == nullptr)
+		{
+			printf("UE583_NATIVE_ZEN_ORACLE_ERROR invalid_header\\n");
+			return 3;
+		}
+		const FZenPackageSummary& S = *Header.PackageSummary;
+		const int32 UE4 = Header.VersioningInfo.IsSet() ? Header.VersioningInfo->PackageVersion.FileVersionUE4 : -1;
+		const int32 UE5 = Header.VersioningInfo.IsSet() ? Header.VersioningInfo->PackageVersion.FileVersionUE5 : -1;
+        printf(R"(UE583_NATIVE_ZEN_ORACLE {"has_versioning_info":%u,"header_size":%u,"package_flags":%u,"imported_public_export_hashes_offset":%d,"import_map_offset":%d,"export_map_offset":%d,"export_bundle_entries_offset":%d,"dependency_bundle_headers_offset":%d,"dependency_bundle_entries_offset":%d,"imported_package_names_offset":%d,"ue4_version":%d,"ue5_version":%d,"imported_hash_count":%d,"import_count":%d,"export_count":%d,"cell_import_count":%d,"cell_export_count":%d,"bulk_data_count":%d,"export_bundle_count":%d,"dependency_bundle_header_count":%d,"dependency_bundle_entry_count":%d})" "\n",
+			S.bHasVersioningInfo, S.HeaderSize, S.PackageFlags,
+			S.ImportedPublicExportHashesOffset, S.ImportMapOffset, S.ExportMapOffset,
+			S.ExportBundleEntriesOffset, S.DependencyBundleHeadersOffset, S.DependencyBundleEntriesOffset,
+			S.ImportedPackageNamesOffset, UE4, UE5,
+			Header.ImportedPublicExportHashes.Num(), Header.ImportMap.Num(), Header.ExportMap.Num(),
+			Header.CellImportMap.Num(), Header.CellExportMap.Num(), Header.BulkDataMap.Num(),
+			Header.ExportBundleEntries.Num(), Header.DependencyBundleHeaders.Num(), Header.DependencyBundleEntries.Num());
+		for (int32 Index = 0; Index < Header.ExportMap.Num(); ++Index)
+		{
+			const FExportMapEntry& Row = Header.ExportMap[Index];
+			printf("UE583_NATIVE_ZEN_EXPORT %d %llu %llu %llu %u %u\\n", Index,
+				static_cast<unsigned long long>(Row.CookedSerialOffset),
+				static_cast<unsigned long long>(Row.CookedSerialSize),
+				static_cast<unsigned long long>(Row.PublicExportHash),
+				static_cast<uint32>(Row.ObjectFlags), static_cast<uint32>(Row.FilterFlags));
+		}
+		for (int32 Index = 0; Index < Header.DependencyBundleHeaders.Num(); ++Index)
+		{
+			const FDependencyBundleHeader& Row = Header.DependencyBundleHeaders[Index];
+			printf("UE583_NATIVE_ZEN_DEPHEADER %d %d %u %u %u %u\\n", Index, Row.FirstEntryIndex,
+				Row.EntryCount[0][0], Row.EntryCount[0][1], Row.EntryCount[1][0], Row.EntryCount[1][1]);
+		}
+		for (int32 Index = 0; Index < Header.ImportMap.Num(); ++Index)
+		{
+			const FPackageObjectIndex& Row = Header.ImportMap[Index];
+			const uint64 Raw = Row.IsNull() ? ~uint64(0) :
+				((uint64(Row.IsPackageImport() ? 2 : Row.IsScriptImport() ? 1 : 0) << 62) | Row.Value());
+			printf("UE583_NATIVE_ZEN_IMPORT %d %016llX\\n", Index, static_cast<unsigned long long>(Raw));
+		}
+		for (int32 Index = 0; Index < Header.ExportMap.Num(); ++Index)
+		{
+			printf("UE583_NATIVE_ZEN_PUBHASH %d %016llX\\n", Index,
+				static_cast<unsigned long long>(Header.ExportMap[Index].PublicExportHash));
+		}
+		for (int32 Index = 0; Index < Header.DependencyBundleEntries.Num(); ++Index)
+		{
+			printf("UE583_NATIVE_ZEN_DEPENTRY %d %d\\n", Index,
+				Header.DependencyBundleEntries[Index].LocalImportOrExportIndex.ForDebugging());
+		}
+		return 0;
+	}
 
 	// Disable all logging because we want to output to stdout
 	FSelfRegisteringExec::StaticExec(nullptr, TEXT("log logunrealpackagetool only"), *GLog);
